{
  "name": "virtual-assistant",
  "private": true,
  "version": "2.5.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite --host 0.0.0.0 --port 5173",
    "server": "tsx server/index.ts",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/suite.test.ts",
    "test:live": "tsx tests/e2e_live_test.ts",
    "test:cloud": "tsx tests/google_cloud_suite.test.ts",
    "test:exhaustive": "tsx tests/exhaustive_ui_suite.test.ts",
    "test:flow": "tsx tests/clean_slate_and_flow_audit.test.ts",
    "test:voice": "tsx tests/voice_assistant_execution.test.ts",
    "test:dialogue": "tsx tests/conversational_dialogue.test.ts",
    "test:bridge": "tsx tests/antigravity_bridge.test.ts",
    "test:dialogue-sim": "tsx tests/voice_dialogue_simulator.test.ts",
    "test:real-world": "tsx tests/real_world_transcript_suite.test.ts",
    "test:depth": "tsx tests/voice_action_depth_suite.test.ts",
    "test:fidelity": "tsx tests/user_experience_fidelity_suite.test.ts",
    "test:governance": "tsx tests/runtime_hardware_and_multilingual_governance.test.ts",
    "test:flow-audit": "tsx tests/inter_tier_telemetry_flow_audit.test.ts",
    "test:regressions": "tsx tests/regression_database_suite.test.ts",
    "test:matrix": "tsx tests/exhaustive_prompt_matrix_suite.test.ts",
    "test:browser": "tsx tests/headless_browser_render.test.ts",
    "test:eve-v2": "tsx tests/eve_v2_multimodal_and_autonomous.test.ts",
    "test:resilience": "tsx tests/speech_ai_response_pipeline_resilience.test.ts",
    "test:perf": "tsx tests/system_resource_and_telemetry_audit.test.ts",
    "test:memory": "tsx tests/context_memory_and_skill_learning.test.ts",
    "test:integration": "tsx tests/full_assistant_context_integration.test.ts",
    "test:corpus": "tsx tests/speech_audio_corpus_telemetry_replay.test.ts",
    "test:training": "tsx tests/training_feedback_corpus.test.ts",
    "preview": "vite preview --host 0.0.0.0 --port 5173"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^7.9.2",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.13",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
